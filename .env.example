# ============================================================
# METHIX frontend - environment variables template
# Copy to ".env.local" for private local overrides. Never commit secrets.
# Vite only exposes variables that start with VITE_ to the browser.
# ============================================================

# "true"  = run fully in the browser with the built-in mock backend (no server needed)
# "false" = talk to the real ASP.NET Core API at VITE_API_BASE_URL
# If omitted: demo mode is ON when VITE_API_BASE_URL is empty, otherwise OFF.
VITE_DEMO_MODE=true

# Real backend base URL (only used when VITE_DEMO_MODE=false)
VITE_API_BASE_URL=https://localhost:7193/api

# Google OAuth Web Client ID (public value, safe for the browser).
# Leave empty to use the simulated Google account in demo mode.
VITE_GOOGLE_CLIENT_ID=
